{{ nginx_php_fpm_status_managed_comment | comment(prefix='', postfix='') | trim }}
{% set address = nginx_php_fpm_status_bind_address %}
server {
    listen {{ '[' ~ address ~ ']' if ':' in address else address }}:{{ nginx_php_fpm_status_port }};
    server_name localhost;

    access_log off;

    include {{ nginx_php_fpm_status_nginx_locations_dir.rstrip('/') ~ '/*.conf' }};

    location / {
        return 404;
    }
}
